{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public user profile for backpackers and hitchhikers",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "bio": { "type": "string", "maxLength": 300 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "travelKarma": { "type": "number" },
        "badges": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["displayName", "role", "travelKarma", "createdAt"]
    },
    "UserPrivateData": {
      "title": "UserPrivateData",
      "description": "Private sensitive user info such as email and emergency contacts",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 120 },
        "phoneNumber": { "type": "string", "maxLength": 20 },
        "emergencyContactName": { "type": "string", "maxLength": 100 },
        "emergencyContactPhone": { "type": "string", "maxLength": 20 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email"]
    },
    "PlaceDocument": {
      "title": "PlaceDocument",
      "description": "Community-verified budget location across India",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 120 },
        "type": { "type": "string", "enum": ["food", "stay", "water", "camping", "shower", "charging"] },
        "description": { "type": "string", "maxLength": 1000 },
        "location": { "type": "object" },
        "city": { "type": "string", "maxLength": 80 },
        "state": { "type": "string", "maxLength": 80 },
        "priceMin": { "type": "number" },
        "priceMax": { "type": "number" },
        "rating": { "type": "number" },
        "reportCount": { "type": "number" },
        "verified": { "type": "boolean" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "creatorName": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "tags": { "type": "array" },
        "timing": { "type": "string", "maxLength": 100 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "type", "description", "location", "city", "state", "priceMin", "priceMax", "createdBy", "status"]
    },
    "HitchhikingSpot": {
      "title": "HitchhikingSpot",
      "description": "Highway toll bay or hitchhiking pickup corridor",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 120 },
        "location": { "type": "object" },
        "roadName": { "type": "string", "maxLength": 100 },
        "direction": { "type": "string", "maxLength": 200 },
        "difficulty": { "type": "string", "enum": ["Easy", "Moderate", "Challenging"] },
        "averageWaitMinutes": { "type": "number" },
        "bestTime": { "type": "string", "maxLength": 100 },
        "safetyRating": { "type": "number" },
        "reportCount": { "type": "number" },
        "lastVerifiedAt": { "type": "string" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "creatorName": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "vehicleTypes": { "type": "array" },
        "notes": { "type": "string", "maxLength": 1000 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "location", "roadName", "direction", "difficulty", "createdBy", "status"]
    },
    "Report": {
      "title": "Report",
      "description": "User feedback and verification of place or hitchhiking spot",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "targetType": { "type": "string", "enum": ["place", "hitchhikingSpot"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 1000 },
        "pricePaid": { "type": "number" },
        "visitedAt": { "type": "string", "maxLength": 50 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "safetyIssueReported": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "targetType", "targetId", "rating", "comment", "createdBy", "status"]
    },
    "Journey": {
      "title": "Journey",
      "description": "Calculated ultra-budget travel itinerary across India",
      "type": "object",
      "properties": {
        "from": { "type": "string", "maxLength": 100 },
        "to": { "type": "string", "maxLength": 100 },
        "budget": { "type": "number" },
        "days": { "type": "number" },
        "travelStyle": { "type": "string", "enum": ["Cheapest", "Balanced", "Adventure"] },
        "estimatedTransportCost": { "type": "number" },
        "estimatedFoodCost": { "type": "number" },
        "estimatedAccommodationCost": { "type": "number" },
        "emergencyBudget": { "type": "number" },
        "totalEstimatedCost": { "type": "number" },
        "dailyAverage": { "type": "number" },
        "suggestedStops": { "type": "array" },
        "routePolyline": { "type": "string", "maxLength": 5000 },
        "notes": { "type": "string", "maxLength": 2000 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["from", "to", "budget", "days", "travelStyle", "createdBy"]
    },
    "TravellerPost": {
      "title": "TravellerPost",
      "description": "Backpacker field journal or trip review",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorAvatar": { "type": "string", "maxLength": 500 },
        "title": { "type": "string", "maxLength": 150 },
        "content": { "type": "string", "maxLength": 2000 },
        "route": { "type": "string", "maxLength": 200 },
        "costPerDay": { "type": "number" },
        "likes": { "type": "number" },
        "tips": { "type": "array" },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorName", "title", "content", "createdBy"]
    },
    "SavedTrip": {
      "title": "SavedTrip",
      "description": "User saved journey bookmark",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "journeyId": { "type": "string", "maxLength": 128 },
        "journey": { "type": "object" },
        "customNotes": { "type": "string", "maxLength": 500 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "savedAt": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "journeyId", "journey", "createdBy"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Safety alert or contribution update for a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 120 },
        "message": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["info", "safety", "verification", "karma"] },
        "read": { "type": "boolean" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "read", "createdBy"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized administrator / community guardian UID mapping",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 120 },
        "grantedAt": { "type": "string", "format": "date-time" },
        "grantedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Public nomad user profiles"
    },
    "/users/{userId}/private/{docId}": {
      "schema": "UserPrivateData",
      "description": "Private contact info accessible strictly by user owner or admin"
    },
    "/places/{placeId}": {
      "schema": "PlaceDocument",
      "description": "Budget places (food, stay, water, camping, shower, charging)"
    },
    "/hitchhikingSpots/{spotId}": {
      "schema": "HitchhikingSpot",
      "description": "Highway toll bay pickup corridors and hitchhiking points"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Community verification feedback and visit logs"
    },
    "/journeys/{journeyId}": {
      "schema": "Journey",
      "description": "Generated or saved India trip itineraries"
    },
    "/travellerPosts/{postId}": {
      "schema": "TravellerPost",
      "description": "Community traveller journals and highway dispatch reports"
    },
    "/savedTrips/{tripId}": {
      "schema": "SavedTrip",
      "description": "Bookmarked journeys per user"
    },
    "/notifications/{notificationId}": {
      "schema": "NotificationItem",
      "description": "In-app notifications and alerts"
    },
    "/admins/{adminId}": {
      "schema": "AdminRecord",
      "description": "Document-based admin authorization table"
    }
  }
}
